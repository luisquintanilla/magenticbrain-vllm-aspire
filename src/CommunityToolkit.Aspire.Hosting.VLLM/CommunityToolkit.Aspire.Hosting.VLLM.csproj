<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>An Aspire hosting integration for running vLLM — a high-throughput, OpenAI-compatible LLM inference server — in a container, with GPU support and Hugging Face model serving.</Description>
    <PackageTags>aspire hosting vllm ai llm gpu inference openai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CommunityToolkit.Aspire.Hosting.VLLM.Tests" />
  </ItemGroup>

</Project>
